# All of these are OPTIONAL. Yojana Setu works fully without any key —
# matching is rule-based and runs in the browser. A free LLM key only adds
# smarter re-ranking, simpler explanations, and free-text need understanding.

# Pick one: "gemini" | "groq". If unset, the first key found below is used.
LLM_PROVIDER=

# Google Gemini — free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default tries gemini-flash-lite-latest, then gemini-flash-latest.
GEMINI_MODEL=

# Groq — free tier key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# WhatsApp bot (optional) — Meta WhatsApp Cloud API, free for user-started chats.
# Setup: developers.facebook.com → create app → add "WhatsApp" → copy the values below.
# Webhook URL: https://<your-site>/api/whatsapp   (subscribe to the "messages" field)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; paste the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings → Basic). Used to check that webhook calls really come from Meta.
WHATSAPP_APP_SECRET=
# The bot's phone number with country code, digits only (e.g. 919876543210).
# Shows a "Chat on WhatsApp" card on the home page.
NEXT_PUBLIC_WHATSAPP_NUMBER=
